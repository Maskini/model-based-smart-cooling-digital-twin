MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
DEVICE_ID=cooling-01
DATABASE_PATH=data/twin.sqlite
SIMULATION_MODE=true
AGENT_ENABLED=true
LLM_ENABLED=false
TELEMETRY_TIMEOUT=10

# Owner login for live controls. Public simulation does not require a password.
DASHBOARD_PASSWORD=

# Shared dashboard/API deployment
BACKEND_URL=http://127.0.0.1:8000
HARDWARE_TRANSPORT=REST
HARDWARE_API_TOKEN=
ADMIN_API_TOKEN=
PUBLIC_DEMO=true
SIMULATION_START_TEMPERATURE=27
SIMULATION_HUMIDITY=47
SIMULATION_HEAT_LOAD=0.12
SIMULATION_MAX_SESSIONS=16
SIMULATION_SESSION_TTL=900
# Optional diagnostic service; never an actuator authority
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
